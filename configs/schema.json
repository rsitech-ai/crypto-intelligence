{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_root",
    "models_root",
    "log_root",
    "bind_address",
    "session_secret_fd",
    "remote_export",
    "connectors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "data_root": {
      "type": "string",
      "minLength": 1
    },
    "models_root": {
      "type": "string",
      "minLength": 1
    },
    "log_root": {
      "type": "string",
      "minLength": 1
    },
    "bind_address": {
      "type": "string",
      "pattern": "^(127\\\\.0\\\\.0\\\\.1|\\\\[::1\\\\]):[0-9]+$"
    },
    "session_secret_fd": {
      "type": "integer",
      "minimum": 3
    },
    "remote_export": {
      "const": false
    },
    "connectors": {
      "type": "array"
    }
  }
}
